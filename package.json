{
  "name": "astro-headers-file",
  "description": "Astro integration that uses existing configuration to write a static headers file for platforms like Cloudflare Pages, Netlify and Vercel.",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/hugo-vrijswijk/astro-headers-file",
  "author": {
    "name": "hugo_vrijswijk",
    "url": "https://github.com/hugo-vrijswijk/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugo-vrijswijk/astro-headers-file.git"
  },
  "packageManager": "pnpm@11.8.0",
  "exports": {
    ".": "./index.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "headers",
    "redirects",
    "cloudflare",
    "cloudflare-pages",
    "netlify",
    "vercel",
    "tooling",
    "utils",
    "utility"
  ],
  "scripts": {
    "build": "tsc",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "25.9.4",
    "astro": "7.0.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  }
}
